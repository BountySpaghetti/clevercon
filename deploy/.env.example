# CleverCon backend env for a hosted deploy (Railway). Set these as service
# variables on the api, workers, and indexer services. Do NOT commit real values.
# Generate secrets with:  openssl rand -hex 32

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Railway injects PORT for the api service automatically; no need to set it.
NETWORK=testnet
TRUST_PROXY=1

# ── Data stores (use Railway reference variables) ────────────────────────────
# On Railway, set these to the references, not literals:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
#   REDIS_URL    = ${{Redis.REDIS_URL}}
DATABASE_URL=
REDIS_URL=

# ── Auth / secrets (generate fresh; BACK UP DELEGATE_ENCRYPTION_KEY) ─────────
JWT_SECRET=
# 32-byte hex. Encrypts each user's delegate secret at rest. If you lose this,
# every stored delegate becomes undecryptable. Back it up securely.
DELEGATE_ENCRYPTION_KEY=
# SEP-10 wallet auth. Must match your frontend domain or some wallets reject login.
HOME_DOMAIN=app.yourdomain.com
WEB_AUTH_DOMAIN=app.yourdomain.com
# Optional: pin a stable SEP-10 server signing key (else an ephemeral one is used).
# SERVER_SIGNING_KEY=

# ── CORS (lock to your frontend origin in production) ────────────────────────
CORS_ORIGINS=https://app.yourdomain.com

# ── Stellar / contracts (testnet defaults already shipped; override for mainnet)
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
AGENT_VAULT_CONTRACT_ID=CCLUFH2E5UMJCNB4ZEH3ZP6LGER54J6GSG3YY55T4CIMPSZROU2NU44V
POLICY_VERIFIER_CONTRACT_ID=CAZ2VC6PYIVQ5XLCZ3BP3SPHFTUKFNSQZVAWHS3N5BDLWDOAUK5VHNRP
USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# ── Chat agent (optional; falls back to a deterministic parser without a key) ─
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# ── x402 (optional; defaults to the public facilitator) ──────────────────────
# X402_FACILITATOR_URL=https://www.x402.org/facilitator

# ── Mainnet (when you cut over) ──────────────────────────────────────────────
# Flip NETWORK=mainnet and provide the public-network values below. The backend
# refuses to start on mainnet if any of these are still testnet.
#   NETWORK=mainnet
#   NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
#   STELLAR_RPC_URL=<your mainnet Soroban RPC provider URL>   # required; no free public one
#   USDC_SAC=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI   # Circle USDC SAC (mainnet)
#   AGENT_VAULT_CONTRACT_ID / POLICY_VERIFIER_CONTRACT_ID = <your mainnet-deployed contracts>
# Deploy the contracts to mainnet first, then set their ids here. The frontend
# switches with VITE_NETWORK=mainnet.
