# CleverCon — local development environment
#
# Copy to .env (the `npm run setup` script does this with `cp -n`), then fill in
# the secrets below. Postgres + Redis come from docker-compose (`npm run db:up`).
# For a hosted deploy, use deploy/.env.example instead (Railway references, etc.).
#
# Quick start:
#   cp .env.example .env      # then set JWT_SECRET + DELEGATE_ENCRYPTION_KEY below
#   npm run db:up             # Postgres + Redis via docker-compose
#   npm run db:generate && npm run db:push && npm run db:seed
#   npm run dev               # api + workers + indexer + web
#
# Generate secrets with:  openssl rand -hex 32


# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# NETWORK: local (mocks, no chain) | testnet (default) | mainnet (not yet)
NETWORK=testnet
# BACKEND: demo (backendless; powers the free Vercel review site) | full (real API)
BACKEND=full
# Trusted proxy hops in front of the API. 0 for a direct local run; 1 behind a
# single load balancer (so rate limiting sees the real client IP).
TRUST_PROXY=0


# ── Data stores (match docker-compose.yml defaults) ──────────────────────────
POSTGRES_USER=clevercon
POSTGRES_PASSWORD=clevercon
POSTGRES_DB=clevercon
POSTGRES_PORT=5432
DATABASE_URL=postgresql://clevercon:clevercon@localhost:5432/clevercon
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379


# ── API / auth ───────────────────────────────────────────────────────────────
API_PORT=4100
JWT_SECRET=change-me-in-local-only
JWT_ACCESS_TTL=15m
# SEP-10 wallet auth. Must match the frontend domain or some wallets reject login.
HOME_DOMAIN=localhost
WEB_AUTH_DOMAIN=localhost
# Optional: pin a stable SEP-10 server signing key (else an ephemeral dev key is
# used and login challenges do not survive a restart). Generate one with:
#   node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
SERVER_SIGNING_KEY=
# Comma-separated CORS allowlist. Leave empty locally (any origin is reflected);
# set to your frontend origin(s) in production.
CORS_ORIGINS=


# ── Delegate encryption (enables automatic settlement) ───────────────────────
# 32-byte hex/base64. Encrypts each user's spending-delegate secret at rest.
# When set, the platform can provision per-user delegates and settle automatically;
# when unset, tasks run off-chain only. Shared with the worker.
# BACK THIS UP: lose it and every stored delegate becomes undecryptable.
DELEGATE_ENCRYPTION_KEY=


# ── Stellar / contracts (testnet defaults; override for mainnet) ─────────────
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
AGENT_VAULT_CONTRACT_ID=CD3RTRZQE6ZU3FPU5GTMIS3II3C22OP22RTCAZ6AE3T3BI7XMTOKEMLA
POLICY_VERIFIER_CONTRACT_ID=CBILHCY4FEYU7RMWBHJX42QJ5TILHZ33HNOD7A6FXTXKB7X57N4LZQ2D
USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Optional on-chain agent registry (Phase 4). When both are set the API anchors
# service manifest hashes + reputation on-chain (platform is the registry admin).
# REGISTRY_CONTRACT_ID=CAN2A7GA2PNL4BYEBN3DZM3G74CNMJ2WAB2WTEMO4L6MIY5F2AQ4H6RM
# REGISTRY_ADMIN_KEY=S...
# Optional vault admin key (the address passed to the vault's init) so the
# operator console can read/set the protocol fee. KMS in production.
# VAULT_ADMIN_KEY=S...


# ── Chat agent (optional; deterministic parser + forms work without a key) ────
# AGENT_PROVIDER: auto (default; picks whichever key is present) | anthropic | openai | none
AGENT_PROVIDER=auto
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
# OpenAI-compatible fallback (OpenAI, Gemini OpenAI-compat, OpenRouter, Ollama/vLLM):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini


# ── Frontend (apps/web; VITE_ vars are browser-exposed) ──────────────────────
VITE_NETWORK=testnet
VITE_BACKEND=demo
VITE_API_URL=http://localhost:4100
VITE_WS_URL=ws://localhost:4100


# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# Point at an OTLP collector (e.g. http://localhost:4318) to enable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
